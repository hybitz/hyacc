<div class="d-inline-flex flex-nowrap align-items-start gap-3">
  <table class="table table-sm mb-0 w-auto">
    <tbody>
      <tr>
        <th><%= @e.class.human_attribute_name :last_name %><%= @e.class.human_attribute_name :first_name %></th>
        <td><%= @e.last_name %><%= @e.first_name %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :name_kana %></th>
        <td><%= @e.last_name_kana %><%= @e.first_name_kana %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :sex %></th>
        <td><%= HyaccConst::SEX_TYPES[@e.sex] %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :birth %></th>
        <td><%= @e.birth %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :zip_code %></th>
        <td><%= @e.zip_code %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :address %></th>
        <td><%= @e.address %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :my_number %></th>
        <td><%= @e.my_number %></td>
      </tr>
      <tr>
        <th class="text-nowrap"><%= @e.class.human_attribute_name :social_insurance_reference_number %></th>
        <td><%= @e.social_insurance_reference_number %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :num_of_dependent %></th>
        <td><%= @e.num_of_dependent %></td>
      </tr>
      <tr>
        <th colspan="2" class="text-center">給与振込口座</th>
      </tr>
      <tr>
        <th>金融機関名称</th>
        <td><%= @e.employee_bank_account&.bank&.name %></td>
      </tr>
      <tr>
        <th>支店名称</th>
        <td><%= @e.employee_bank_account&.bank_office&.name %></td>
      </tr>
      <tr>
        <th>口座番号</th>
        <td><%= @e.employee_bank_account&.code %></td>
      </tr>
    </tbody>
  </table>

  <table class="table table-sm mb-0 w-auto">
    <tbody>
      <tr>
        <th><%= @e.class.human_attribute_name :employment_date %></th>
        <td><%= @e.employment_date %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :retirement_date %></th>
        <td><%= @e.retirement_date %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :executive %></th>
        <td><%= @e.executive? ? "役員" : "従業員" %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :position %></th>
        <td><%= @e.position %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :full_time %></th>
        <td><%= @e.full_time.nil? ? '' : (@e.full_time ? '常勤' : '非常勤') %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :duty_description %></th>
        <td><%= @e.duty_description %></td>
      </tr>
      <tr>
        <th class="text-nowrap"><%= @e.class.human_attribute_name :representative_or_family_type %></th>
        <td><%= @e.representative_or_family_type_name %></td>
      </tr>
      <tr>
        <th><%= @e.class.human_attribute_name :relationship_to_representative %></th>
        <td><%= @e.relationship_to_representative %></td>
      </tr>
      <tr>
        <th>退職金積立開始時期</th>
        <td><%= get_start_ym_of_retirement_savings(@e) %></td>
      </tr>
      <tr>
        <th>所属部門</th>
        <td>
          <% if @branch_employees.any? %>
            <table class="table table-sm mb-0">
              <thead>
                <tr>
                  <th>部門</th>
                  <th class="text-center">デフォルト</th>
                </tr>
              </thead>
              <tbody>
                <% @branch_employees.each do |be| %>
                  <tr>
                    <td><%= be.branch.name %></td>
                    <td class="text-center">
                      <% if be.default_branch? %>
                        <%= image_tag 'checkmark.gif', size: '16x16', alt: 'はい', title: 'はい' %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>
</div>
