<div id="data_<%= @data.id %>" class="border-bottom border-end">
  <%= form_for([:mm, @data], remote: true, html: { class: 'd-flex align-items-center' }) do |f| %>
    <div class="p-2" style="width: 90px;"><%= @data.ym %></div>
    <div class="p-2" style="width: 120px;"><%= @data.employee.fullname %></div>
    <div class="p-2 text-end" style="width: 100px;">
      <%= f.text_field :amount, maxlength: 8, size: 6, class: 'form-control form-control-sm text-end' %>
    </div>
    <div class="p-2 text-center text-nowrap" style="width: 160px;">
      <%= f.submit class: 'btn btn-sm btn-light' %>
      <%= link_to 'キャンセル', [:mm, @data], class: 'btn btn-sm btn-light', remote: true %>
    </div>
  <% end %>
</div>
