<%= render 'common/search' %>
<%= flash_notice %>

<div class="careers-page">
  <% if @careers.present? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>期間</th>
            <th>氏名</th>
            <th>取引先</th>
            <th>プロジェクト名</th>
            <th class="text-center"></th>
          </tr>
        </thead>
        <tbody>
          <% @careers.each do |c| %>
            <tr>
              <td><%= c.start_from %> ～ <%= c.end_to %></td>
              <td><%= c.employee.fullname %></td>
              <td><%= c.customer_name %></td>
              <td><%= link_to c.project_name, mm_career_path(c), remote: true, class: 'show' %></td>
              <td class="text-center text-nowrap">
                <%= link_to '編集', edit_mm_career_path(c), remote: true, class: 'btn btn-sm btn-light' %>
                <%= link_to '削除', mm_career_path(c), data: {confirm: '削除します。よろしいですか？'}, method: :delete, class: 'btn btn-sm btn-light' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= will_paginate @careers %>
    <%= link_to '追加', new_mm_career_path({ employee_id: finder.employee_id }.compact), class: 'add btn btn-light', remote: true if @customers.present? %>
  <% elsif @careers %>
    <div class="alert alert-warning">該当するデータが見つかりませんでした。</div>
    <% if @customers.present? %>
      <%= link_to '追加', new_mm_career_path({ employee_id: finder.employee_id }.compact), class: 'add btn btn-light', remote: true %>
    <% else %>
      <div class="alert alert-info">
        業務経歴を追加するには受注先の登録が必要です。
        <div class="mt-2">
          <%= link_to '取引先管理へ', mm_customers_path, class: 'btn btn-light' %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
