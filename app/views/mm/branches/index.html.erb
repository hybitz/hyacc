<%= flash_notice %>
<script>
  (function() {
    const data = [
      <% current_company.branches.where(parent: nil, deleted: false).each do |b| %>
        <%= convert_branch_to_json(b) %>,
      <% end %>
    ];

    $(document).off('turbolinks:load.mmBranchTree').on('turbolinks:load.mmBranchTree', function() {
      const $tree = $('#branch_tree');
      $tree.tree('destroy');
      $tree.tree({
        data: data,
        selectable: false,
        saveState: 'branch_tree',
        autoEscape: false,
        dragAndDrop: false,
      });
    });
  })();
</script>
<div id="branch_tree"></div>
