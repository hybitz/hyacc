<script>
  $(document).ready(function() {
    // キーワード生成
    $('input[value=キーワード生成]').click(function() {
      const url = '<%= url_for action: :get_keywords %>';
      const params = {remarks: $('#simple_slip_template_remarks').val()};
      $.get(url, params, function(data) {
        $('#simple_slip_template_keywords').val(data);
      });
    });

    // 勘定科目の変更
    let initial_value = '<%= @simple_slip_template.sub_account_id %>';
    $('#simple_slip_template_account_id').change(function(eventData) {
      const account = $(this);
      const url = '<%= url_for action: 'get_sub_accounts' %>';
      const params = {account_id: account.val(), selected: initial_value, format: 'html'};
      $.get(url, params, function(data) {
        account.closest('td').next().html(data);
      });
      initial_value = '';
    }).change();
  });
</script>

<%= form_with model: [:mm, @simple_slip_template], data: {remote: true} do |f| %>
  <%= flash_notice %>

  <%= f.hidden_field :owner_type %>
  <%= f.hidden_field :owner_id %>

  <table class="table table-sm mb-0">
    <tr>
      <th><%= SimpleSlipTemplate.human_attribute_name :remarks %></th>
      <td>
        <%= f.text_field :remarks, class: 'form-control form-control-sm' %>
      </td>
      <td>
        <input type="button" value="キーワード生成" class="btn btn-light btn-sm"/>
      </td>
    </tr>
    <tr>
      <th><%= SimpleSlipTemplate.human_attribute_name :description %></th>
      <td colspan="2">
        <%= f.text_field :description, class: 'form-control form-control-sm' %>
      </td>
    </tr>
    <tr>
      <th><%= SimpleSlipTemplate.human_attribute_name :keywords %></th>
      <td colspan="2">
        <%= f.text_field :keywords, class: 'form-control form-control-sm' %>
      </td>
    </tr>
  </table>
  <table class="table table-sm mb-0">
    <tr>
      <th><%= SimpleSlipTemplate.human_attribute_name :account_id %></th>
      <th><%= SimpleSlipTemplate.human_attribute_name :sub_account_id %></th>
      <th><%= SimpleSlipTemplate.human_attribute_name :branch_id %></th>
      <th><%= SimpleSlipTemplate.human_attribute_name :dc_type %></th>
    </tr>
    <tr>
      <td><%= collection_select_code_and_name 'simple_slip_template', 'account_id', finder.accounts, :id, :name, {}, class: 'form-select form-select-sm d-inline-block w-auto mw-100' %></td>
      <td></td>
      <td><%= f.collection_select :branch_id, current_company.branches, :id, :name, {include_blank: true}, class: 'form-select form-select-sm d-inline-block w-auto mw-100' %></td>
      <td><%= f.select :dc_type, dc_types, {include_blank: true}, class: 'form-select form-select-sm d-inline-block w-auto mw-100' %></td>
    </tr>
  </table>
  <table class="table table-sm mb-0">
    <tr>
      <th><%= SimpleSlipTemplate.human_attribute_name :tax_type %></th>
      <th><%= SimpleSlipTemplate.human_attribute_name :tax_rate_percent %></th>
      <th><%= SimpleSlipTemplate.human_attribute_name :amount %></th>
      <th><%= SimpleSlipTemplate.human_attribute_name :tax_amount %></th>
      <th><%= SimpleSlipTemplate.human_attribute_name :focus_on_complete %></th>
    </tr>
    <tr>
      <td><%= f.select :tax_type, tax_types, {include_blank: true}, class: 'form-select form-select-sm d-inline-block w-auto mw-100' %></td>
      <td class="text-end text-nowrap" style="width: 6em;">
        <%= f.text_field :tax_rate_percent, class: 'form-control form-control-sm d-inline-block text-end', style: 'width: 3em;' %>
        %
      </td>
      <td><%= f.text_field :amount, class: 'form-control form-control-sm text-end d-inline-block', style: 'width: 10em; max-width: 100%;' %></td>
      <td><%= f.text_field :tax_amount, class: 'form-control form-control-sm text-end d-inline-block', style: 'width: 8em; max-width: 100%;' %></td>
      <td><%= f.select :focus_on_complete, focus_on_completes, {include_blank: true}, class: 'form-select form-select-sm d-inline-block w-auto mw-100' %></td>
    </tr>
  </table>
<% end %>
