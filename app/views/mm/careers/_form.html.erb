<%= form_with model: [:mm, @c], data: {remote: true} do |f| %>
  <%= flash_notice %>

  <table class="table table-sm mb-0">
    <tr>
      <th>従業員</th>
      <td><%= f.collection_select :employee_id, finder.employees, 'id', 'fullname', {}, class: 'form-select form-select-sm d-inline-block w-auto mw-100' %></td>
    </tr>
    <tr>
      <th>取引先</th>
      <td><%= f.collection_select :customer_id, @customers, 'id', 'name', {}, class: 'form-select form-select-sm d-inline-block w-auto mw-100' %></td>
    </tr>
    <tr>
      <th>プロジェクト名</th>
      <td><%= f.text_field :project_name, class: 'form-control form-control-sm', style: 'width: 15em; max-width: 100%;' %></td>
    </tr>
    <tr>
      <th>期間</th>
      <td>
        <div class="d-flex flex-nowrap gap-1 align-items-center">
          <%= f.date_select :start_from, {}, { class: 'form-select form-select-sm d-inline-block w-auto', style: 'vertical-align: middle;' } %>
          <b>～</b>
          <%= f.date_select :end_to, {}, { class: 'form-select form-select-sm d-inline-block w-auto', style: 'vertical-align: middle;' } %>
        </div>
      </td>
    </tr>
    <tr>
      <th>概要</th>
      <td><%= f.text_area :description, rows: 3, class: 'form-control form-control-sm', style: 'width: 15em; max-width: 100%;' %></td>
    </tr>
    <tr>
      <th>規模</th>
      <td><%= f.text_field :project_size, class: 'form-control form-control-sm', style: 'width: 15em; max-width: 100%;' %></td>
    </tr>
    <tr>
      <th>工程</th>
      <td><%= f.text_field :process, class: 'form-control form-control-sm', style: 'width: 15em; max-width: 100%;' %></td>
    </tr>
    <tr>
      <th>役割</th>
      <td><%= f.text_field :role, class: 'form-control form-control-sm', style: 'width: 15em; max-width: 100%;' %></td>
    </tr>
    <tr>
      <th>スキル</th>
      <td>
        <table class="table table-sm mb-0">
          <tr>
            <th>機種</th>
            <th>OS</th>
            <th>DB</th>
            <th>言語</th>
            <th>その他</th>
          </tr>
          <tr>
            <td><%= f.text_area :hardware_skill, rows: 3, class: 'form-control form-control-sm', style: 'width: 12em; max-width: 100%;' %></td>
            <td><%= f.text_area :os_skill, rows: 3, class: 'form-control form-control-sm', style: 'width: 12em; max-width: 100%;' %></td>
            <td><%= f.text_area :db_skill, rows: 3, class: 'form-control form-control-sm', style: 'width: 12em; max-width: 100%;' %></td>
            <td><%= f.text_area :language_skill, rows: 3, class: 'form-control form-control-sm', style: 'width: 12em; max-width: 100%;' %></td>
            <td><%= f.text_area :other_skill, rows: 3, class: 'form-control form-control-sm', style: 'width: 12em; max-width: 100%;' %></td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
<% end %>
